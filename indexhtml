      <div class="btn-row"><button type="button" class="btn btn-sec" id="createBtn">+ Create routine</button><button type="button" class="btn btn-sec" disabled title="Not in this test build">Import video</button></div>
      <div class="label"><span>Your routines</span><span>${data.routines.length}</span></div>
      ${list()}</div>`;
    $('startBtn').onclick = () => go('pick');
    $('createBtn').onclick = () => { draft = { name: '', poses: [] }; go('create'); };
    bindCards();
  }
  function vPick() {
    screen.innerHTML = `<div class="pad"><button type="button" class="back" id="bk">${I.left} Back</button>
      <h2 class="hero" style="font-size:34px">Pick a routine</h2><p class="sub">Tap one to start the timer right away.</p>${list()}</div>`;
    $('bk').onclick = () => go('home'); bindCards();
  }

  /* ---------- create ---------- */
  function vCreate() {
    const d = draft;
    screen.innerHTML = `<div class="pad"><button type="button" class="back" id="bk">${I.left} Cancel</button>
      <h2 class="hero" style="font-size:34px">New routine</h2>
      <div class="field"><label for="rc-name">Name</label><input id="rc-name" maxlength="40" placeholder="e.g. Lunch break reset" value="${esc(d.name)}"></div>
      <div class="field"><label>Poses (${d.poses.length}) · ${fmt(d.poses.reduce((a, p) => a + p.secs, 0))} total</label>
        <div class="plist">${d.poses.length ? d.poses.map((p, i) => `<div class="prow"><span class="sw" style="width:30px;height:30px;border-radius:9px;background:var(--sage-200)">${fig(p.pose)}</span><span class="n">${esc(p.name)}</span><input id="rc-secs-${i}" type="number" min="1" max="600" value="${p.secs}" data-i="${i}" aria-label="Seconds for ${esc(p.name)}"><span class="s">s</span><button type="button" class="x" data-rm="${i}" aria-label="Remove ${esc(p.name)}">×</button></div>`).join('') : '<div class="empty" style="padding:12px">Tap a pose below to add it.</div>'}</div>
      </div>
      <div class="field"><label>Add a pose</label><div class="chips">${Object.keys(POSES).map(k => `<button type="button" class="chip" data-add="${k}">${fig(k)}${esc(POSES[k][0])}</button>`).join('')}</div></div>
      <div class="formerr" id="formErr"></div>
      <button type="button" class="btn btn-primary" id="saveR">Save routine</button></div>`;
    $('bk').onclick = () => { draft = null; go('home'); };
    $('rc-name').oninput = e => d.name = e.target.value;
    screen.querySelectorAll('[data-add]').forEach(b => b.onclick = () => { d.poses.push({ pose: b.dataset.add, name: POSES[b.dataset.add][0], cue: '', secs: 30 }); keepScroll(vCreate); });
    screen.querySelectorAll('[data-rm]').forEach(b => b.onclick = () => { d.poses.splice(+b.dataset.rm, 1); keepScroll(vCreate); });
    screen.querySelectorAll('.prow input').forEach(inp => inp.oninput = () => { d.poses[+inp.dataset.i].secs = parseInt(inp.value, 10) || 0; });
    $('saveR').onclick = () => {
      const err = !d.name.trim() ? 'Give the routine a name.' : !d.poses.length ? 'Add at least one pose.'
        : d.poses.some(p => !(p.secs >= 1 && p.secs <= 600)) ? 'Each pose needs 1 to 600 seconds.' : '';
      if (err) { $('formErr').textContent = err; return; }
      const r = { id: 'r' + Date.now().toString(36), name: d.name.trim(), color: data.routines.length % 2 ? 'sage' : 'clay', poses: d.poses.map(p => ({ ...p })) };
      data.routines.push(r); draft = null;
      commit(`Created routine “${r.name}” with ${r.poses.length} poses`);
      check('c3'); go('home');
    };
  }
  function keepScroll(fn) { const y = screen.scrollTop; fn(); screen.scrollTop = y; }

  /* ---------- timer ---------- */
  function begin(id) {
    const r = data.routines.find(x => x.id === id); if (!r) return;
    run = { r: JSON.parse(JSON.stringify(r)), i: 0, left: r.poses[0].secs, running: true, skipped: 0, used: 0, sub: 0 };
    log(`Started “${r.name}”`);
    go('timer'); startTick();
  }
  function startTick() {
    stopTick();
    tick = setInterval(() => {
      run.left -= 1; run.used += 1;
      if (run.left <= 0) next(false); else paint();
    }, 1000 / speed);
  }
  function stopTick() { if (tick) clearInterval(tick); tick = null; }
  function next(manual) {
    if (manual) { run.skipped += 1; log(`Skipped “${run.r.poses[run.i].name}”`); check('c2'); }
    if (run.i < run.r.poses.length - 1) { run.i += 1; run.left = run.r.poses[run.i].secs; vTimer(); }
    else finish();
  }
  function prev() {
    if (run.i > 0) run.i -= 1;
    run.left = run.r.poses[run.i].secs; vTimer(); check('c2');
    log(`Went back to “${run.r.poses[run.i].name}”`);
  }
  function finish() {
    stopTick();
    const r = run.r;
    const entry = { routineId: r.id, name: r.name, completedAt: new Date().toISOString(), poses: r.poses.length - run.skipped, secs: run.used };
    data.history.unshift(entry);
    run.result = entry;
    commit(`Finished “${r.name}”: ${entry.poses} poses, ${fmt(entry.secs)}`);
    check('c1');
    go('done');
  }
  function pct() {
    const tot = totalSecs(run.r);
    const doneS = run.r.poses.slice(0, run.i).reduce((a, p) => a + p.secs, 0) + (run.r.poses[run.i].secs - run.left);
    return Math.min(100, Math.round(doneS / tot * 100));
  }
  const R = 82, C = 2 * Math.PI * R;
  function vTimer() {
    const p = run.r.poses[run.i], n = run.r.poses[run.i + 1];
    screen.innerHTML = `<div class="timer">
      <div class="timer-top"><button type="button" class="back" id="exit">${I.left} Exit</button>
        <div class="track"><div class="fill" id="fill"></div></div><div class="cap" id="cap"></div></div>
      <div class="tmid">
        <div class="ring"><svg viewBox="0 0 190 190"><circle class="ring-bg" cx="95" cy="95" r="${R}"/><circle class="ring-fg" id="ringFg" cx="95" cy="95" r="${R}" stroke-dasharray="${C}"/></svg>
          <div class="ring-fig">${fig(p.pose)}</div></div>
        <h2 class="pname">${esc(p.name)}</h2>${p.cue ? `<p class="pcue">${esc(p.cue)}</p>` : ''}
        <div class="ptime" id="ptime"></div>
        <div class="pnext">${n ? 'Next: ' + esc(n.name) : 'Last pose'} · ${run.i + 1} of ${run.r.poses.length}</div>
      </div>
      <div class="ctrls">
        <div class="ccol"><button type="button" class="cbtn" id="prv" aria-label="Previous pose">${I.bwd}</button>Back</div>
        <div class="ccol"><button type="button" class="cbtn cmain" id="pp"></button><span id="ppl"></span></div>
        <div class="ccol"><button type="button" class="cbtn" id="nxt" aria-label="Skip pose">${I.fwd}</button>Skip</div>
      </div></div>`;
    $('exit').onclick = () => { stopTick(); log(`Exited “${run.r.name}” at ${pct()}%`); run = null; go('home'); };
    $('pp').onclick = () => {
      run.running = !run.running;
      if (run.running) startTick(); else stopTick();
      log(run.running ? 'Resumed' : 'Paused'); check('c2'); paint();
    };
    $('nxt').onclick = () => next(true);
    $('prv').onclick = prev;
    paint();
  }
  function paint() {
    if (!run || ui.view !== 'timer') return;
    const p = run.r.poses[run.i];
    $('ptime').textContent = fmt(run.left);
    $('ringFg').setAttribute('stroke-dashoffset', C * (run.left / p.secs));
    const v = pct(); $('fill').style.width = v + '%'; $('cap').textContent = v + '% complete';
    $('pp').innerHTML = run.running ? I.pause : I.play.replace(' width="16" height="16"', '');
    $('pp').setAttribute('aria-label', run.running ? 'Pause' : 'Resume');
    $('ppl').textContent = run.running ? 'Pause' : 'Resume';
  }

  function vDone() {
    const e = run.result, today = data.history.filter(h => dayKey(h.completedAt) === dayKey(new Date())).length;
    screen.innerHTML = `<div class="done"><div class="badge">${I.check}</div>
      <h2 class="hero" style="font-size:36px">Nice work!</h2>
      <p class="sub" style="margin:0">You finished ${esc(e.name)}. That's one more small thing your body will thank you for.</p>
      <div class="stats"><div class="stat"><b>${e.poses}</b><span>poses done</span></div><div class="stat"><b>${fmt(e.secs)}</b><span>time held</span></div><div class="stat"><b>${today}</b><span>today</span></div></div>
      <button type="button" class="btn btn-primary" id="hm">Back to home</button>
      <button type="button" class="btn btn-sec" id="pg" style="width:100%;margin-top:10px">See progress</button></div>`;
    $('hm').onclick = () => { run = null; go('home'); };
    $('pg').onclick = () => { run = null; check('c4'); ui.tab = 'progress'; go('progress'); };
  }

  /* ---------- progress (computed from history) ---------- */
  function vProgress() {
    const days = new Set(data.history.map(h => dayKey(h.completedAt)));
    const now = new Date(), mon = new Date(now); mon.setHours(0, 0, 0, 0); mon.setDate(mon.getDate() - ((mon.getDay() + 6) % 7));
    const week = [...Array(7)].map((_, i) => { const d = new Date(mon); d.setDate(mon.getDate() + i); return d; });
    let streak = 0; const c = new Date(now);
    if (!days.has(dayKey(c))) c.setDate(c.getDate() - 1);
    while (days.has(dayKey(c))) { streak++; c.setDate(c.getDate() - 1); }
    const thisWeek = week.filter(d => days.has(dayKey(d))).length;
    const when = iso => {
      const d = new Date(iso), diff = Math.round((new Date(dayKey(now)) - new Date(dayKey(d))) / 864e5);
      const t = d.toLocaleTimeString([], { hour: 'numeric', minute: '2-digit' });
      return diff === 0 ? `Today, ${t}` : diff === 1 ? `Yesterday, ${t}` : diff < 7 ? `${diff} days ago` : d.toLocaleDateString([], { day: 'numeric', month: 'short' });
    };
    const iconFor = h => { const r = data.routines.find(x => x.id === h.routineId); return r ? r.poses[0].pose : 'childspose'; };
    screen.innerHTML = `<div class="pad"><p class="eyebrow">This week · ${thisWeek} of 7 days</p>
      <h2 class="hero" style="font-size:34px">Your progress</h2>
      <div class="week">${week.map(d => `<div class="day ${days.has(dayKey(d)) ? 'on' : ''} ${dayKey(d) === dayKey(now) ? 'today' : ''}"><div class="dot">${days.has(dayKey(d)) ? I.check : ''}</div><span>${'MTWTFSS'[(d.getDay() + 6) % 7]}</span></div>`).join('')}</div>
      <div class="streak"><b>${streak}</b><span>${streak === 1 ? 'day' : 'days'} in a row. ${streak ? 'One more session tomorrow keeps it going.' : 'Finish a routine today to start a streak.'}</span></div>
      <div class="label"><span>Recent sessions</span><span>${data.history.length} total</span></div>
      ${data.history.length ? data.history.slice(0, 8).map(h => `<div class="hrow"><div class="hicon">${fig(iconFor(h))}</div><div style="min-width:0"><div class="hname">${esc(h.name || 'Routine')}</div><div class="hwhen">${when(h.completedAt)}${h.secs ? ' · ' + fmt(h.secs) : ''}</div></div></div>`).join('') : '<div class="empty">No sessions yet. Finish a routine and it shows up here.</div>'}
    </div>`;
  }

  syncJson(false);
  render();
  log('Test lab opened with ' + data.routines.length + ' routines');
})();
</script>

