    return sample();
  }
  function save() { try { localStorage.setItem(KEY, JSON.stringify(data)); } catch (e) {} }

  let data = load();
  let speed = 1;
  let ui = { tab: 'home', view: 'home' };
  let run = null, tick = null, draft = null;

  const $ = id => document.getElementById(id);
