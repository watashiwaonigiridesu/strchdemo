  }
  function commit(msg) { save(); syncJson(true); if (msg) log(msg); }
  ta.addEventListener('input', () => { dirty = true; setState('dirty', 'Edited — not applied'); });
  function showMsg(kind, html) { const m = $('jsonMsg'); m.className = 'msg ' + kind; m.innerHTML = html; }
  function applyText(text, source) {
    let parsed;
    try { parsed = JSON.parse(text); }
    catch (err) { setState('bad', 'Invalid JSON'); showMsg('bad', `The JSON could not be read: ${esc(err.message)}. Check for a missing comma, quote or bracket near that spot.`); check('c6'); return; }
    const errs = validate(parsed);
    if (errs.length) { setState('bad', 'Not applied'); showMsg('bad', `Fix these and apply again:<ul>${errs.slice(0, 8).map(x => `<li>${esc(x)}</li>`).join('')}</ul>`); check('c6'); return; }
    stopTick(); run = null;
    data = normalise(parsed); dirty = false; save(); syncJson(false);
    ui.view = ui.tab === 'progress' ? 'progress' : 'home'; render();
    showMsg('ok', `Applied. ${data.routines.length} routine${data.routines.length === 1 ? '' : 's'}, ${data.history.length} session${data.history.length === 1 ? '' : 's'} in history.`);
    log(`${source}: ${data.routines.length} routines, ${data.history.length} sessions`);
