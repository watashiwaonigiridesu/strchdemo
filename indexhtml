  }

  const card = r => `<button type="button" class="rcard" data-id="${esc(r.id)}">
      <span class="sw" style="background:var(${r.color === 'clay' ? '--clay-100' : '--sage-200'})">${fig(r.poses[0].pose)}</span>
      <span class="rmeta"><span class="rtitle" style="display:block">${esc(r.name)}</span>
      <span class="rsub" style="display:block">${Math.max(1, Math.round(totalSecs(r) / 60))} min · ${r.poses.length} pose${r.poses.length === 1 ? '' : 's'}</span></span>
      <span class="go">${I.chev}</span></button>`;
  const list = () => data.routines.length
    ? `<div class="rlist">${data.routines.map(card).join('')}</div>`
    : `<div class="empty">No routines yet. Tap “Create routine”, or add one in the JSON panel.</div>`;
  function bindCards() { screen.querySelectorAll('.rcard').forEach(c => c.onclick = () => begin(c.dataset.id)); }

  function vHome() {
    screen.innerHTML = `<div class="pad">
      <p class="eyebrow">Today · daily movement</p>
