    document.querySelectorAll('#speedSeg button').forEach(x => x.setAttribute('aria-pressed', x === b));
    if (run && run.running) startTick();
    log(`Timer speed set to ${speed}×`);
  };

  /* ---------- navigation ---------- */
  tabbar.onclick = e => {
    const b = e.target.closest('button[data-tab]'); if (!b) return;
    if (run) { stopTick(); run = null; log('Left the routine early'); }
