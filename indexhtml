<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
</head>
<body>
<title>strtch Test Lab</title>
<meta name="claude:viewport-fit-sides" content="cover">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Caveat:wght@600;700&family=Manrope:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap">
<style>
/* Layout: phone on the left runs the app; JSON workbench on the right reads and writes the same data. Stacks on phones. */
:root {
  --page: #E7E3D5; --page-ink: #24261E; --page-soft: #6A6C5C; --panel: #F7F5EE; --panel-line: #D3CFBF;
  --code-bg: #FBFAF5; --ok: #2F6B3A; --bad: #A4402A; --warn-bg: #F4E3CF;
  --sage-100: #EEF2E6; --sage-200: #DEE6D2; --forest-700: #2C4A30; --forest-800: #1E3423;
  --ink: #202B1D; --ink-soft: #5E6A54; --clay-500: #BE6C46; --clay-100: #F1DBC9; --line: #D5DCC7; --card: #FCFBF7;
  --f-display: 'Caveat', 'Segoe Print', cursive;
  --f-body: 'Manrope', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  --f-mono: 'JetBrains Mono', ui-monospace, Menlo, Consolas, monospace;
}
@media (prefers-color-scheme: dark) { :root:not([data-theme="light"]) {
  --page: #16170F; --page-ink: #ECEADF; --page-soft: #A5A795; --panel: #1F2118; --panel-line: #34372A;
  --code-bg: #191B13; --ok: #8CC497; --bad: #E48A72; --warn-bg: #3A2C1E; color-scheme: dark; } }
:root[data-theme="dark"] {
  --page: #16170F; --page-ink: #ECEADF; --page-soft: #A5A795; --panel: #1F2118; --panel-line: #34372A;
  --code-bg: #191B13; --ok: #8CC497; --bad: #E48A72; --warn-bg: #3A2C1E; color-scheme: dark; }

*, *::before, *::after { box-sizing: border-box; }
[hidden] { display: none !important; }
body { margin: 0; background: var(--page); color: var(--page-ink); font-family: var(--f-body); font-size: 14px; }
button, input, textarea { font: inherit; }
:focus-visible { outline: 2px solid var(--clay-500); outline-offset: 2px; }

.wrap { max-width: 1120px; margin: 0 auto; padding-block: 28px 48px;
  padding-left: max(16px, env(safe-area-inset-left, 0px)); padding-right: max(16px, env(safe-area-inset-right, 0px)); }
.top { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 12px 24px; margin-bottom: 22px; }
.brand { font-family: var(--f-display); font-weight: 700; font-size: 46px; line-height: .9; color: var(--page-ink); margin: 0; }
.brand small { font-family: var(--f-body); font-size: 13px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--page-soft); margin-left: 8px; }
.top p { margin: 6px 0 0; color: var(--page-soft); max-width: 58ch; line-height: 1.5; }
.speed { display: flex; align-items: center; gap: 8px; color: var(--page-soft); font-size: 12px; font-weight: 600; }
.seg { display: inline-flex; border: 1px solid var(--panel-line); border-radius: 10px; overflow: hidden; background: var(--panel); }
.seg button { border: 0; background: none; padding: 6px 11px; color: var(--page-ink); cursor: pointer; font-weight: 600; font-size: 12px; font-variant-numeric: tabular-nums; }
.seg button[aria-pressed="true"] { background: var(--forest-700); color: #F3F6EE; }

.layout { display: grid; grid-template-columns: 372px minmax(0, 1fr); gap: 32px; align-items: start; }
@media (max-width: 860px) { .layout { grid-template-columns: minmax(0, 1fr); } .phone { margin: 0 auto; } }

/* ---------- phone ---------- */
.phone { width: 372px; max-width: 100%; aspect-ratio: 372 / 760; background: #14170F; border-radius: 48px; padding: 12px;
  box-shadow: 0 30px 60px -24px rgba(10,12,6,.5); position: relative; }
.phone::before { content: ""; position: absolute; top: 22px; left: 50%; transform: translateX(-50%); width: 86px; height: 20px; background: #14170F; border-radius: 12px; z-index: 5; }
.pi { background: var(--sage-100); color: var(--ink); width: 100%; height: 100%; border-radius: 36px; overflow: hidden; display: flex; flex-direction: column; }
.statusbar { height: 42px; flex-shrink: 0; }
.screen { flex: 1; overflow-y: auto; overflow-x: hidden; scrollbar-width: none; }
.screen::-webkit-scrollbar { display: none; }
.tabbar { flex-shrink: 0; display: flex; justify-content: space-around; padding: 9px 8px 14px; background: var(--card); border-top: 1px solid var(--line); }
.tabbar button { background: none; border: 0; display: flex; flex-direction: column; align-items: center; gap: 4px; font-size: 10.5px; font-weight: 600; color: var(--ink-soft); cursor: pointer; padding: 4px 12px; }
.tabbar button.active { color: var(--forest-700); }
.tabbar svg { width: 20px; height: 20px; }

.pad { padding: 16px 20px 28px; display: flex; flex-direction: column; }
.eyebrow { font-size: 12.5px; color: var(--ink-soft); margin: 0 0 2px; }
.hero { font-family: var(--f-display); font-weight: 700; font-size: 40px; line-height: .95; color: var(--forest-800); margin: 0 0 8px; text-wrap: balance; }
.sub { font-size: 13.5px; color: var(--ink-soft); line-height: 1.5; margin: 0 0 18px; max-width: 30ch; }
.btn { border: 0; border-radius: 16px; font-weight: 700; font-size: 14.5px; cursor: pointer; display: inline-flex; align-items: center; justify-content: center; gap: 8px; transition: transform .12s; }
.btn:active { transform: scale(.97); }
.btn-primary { width: 100%; background: var(--forest-700); color: #F3F6EE; padding: 15px 18px; box-shadow: 0 8px 18px -8px rgba(44,74,48,.55); }
.btn-primary[disabled] { opacity: .5; cursor: default; }
.btn-row { display: flex; gap: 10px; margin-top: 10px; }
.btn-sec { flex: 1; background: var(--card); border: 1.5px solid var(--line); color: var(--forest-800); padding: 12px 8px; font-size: 12.5px; }
.btn-sec[disabled] { opacity: .5; cursor: default; }
.label { font-size: 12px; font-weight: 700; color: var(--ink-soft); margin: 24px 0 10px; display: flex; justify-content: space-between; }
.back { background: none; border: 0; cursor: pointer; color: var(--ink-soft); display: inline-flex; align-items: center; gap: 6px; font-size: 12.5px; font-weight: 600; padding: 2px 0 10px; align-self: flex-start; }
.back svg { width: 15px; height: 15px; }

.rlist { display: flex; flex-direction: column; gap: 10px; }
.rcard { background: var(--card); border: 1px solid var(--line); border-radius: 18px; padding: 12px 13px; display: flex; align-items: center; gap: 12px; cursor: pointer; text-align: left; width: 100%; color: inherit; }
.rcard:active { transform: scale(.985); }
.sw { width: 42px; height: 42px; border-radius: 12px; flex-shrink: 0; display: flex; align-items: center; justify-content: center; color: var(--forest-700); }
.sw svg { width: 26px; height: 26px; }
.rmeta { flex: 1; min-width: 0; }
.rtitle { font-weight: 700; font-size: 14px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.rsub { font-size: 11.5px; color: var(--ink-soft); margin-top: 1px; }
.go { width: 30px; height: 30px; border-radius: 999px; background: var(--sage-200); display: flex; align-items: center; justify-content: center; color: var(--forest-700); flex-shrink: 0; }
.go svg { width: 13px; height: 13px; }
.empty { border: 1.5px dashed var(--line); border-radius: 16px; padding: 18px; text-align: center; color: var(--ink-soft); font-size: 12.5px; line-height: 1.5; }

/* timer */
.timer { height: 100%; display: flex; flex-direction: column; background: linear-gradient(180deg, var(--sage-100), var(--sage-200)); }
.timer-top { padding: 14px 22px 0; display: flex; flex-direction: column; }
.track { height: 6px; background: rgba(44,74,48,.14); border-radius: 999px; overflow: hidden; margin-bottom: 6px; }
.fill { height: 100%; background: var(--forest-700); border-radius: 999px; transition: width .3s; }
.cap { font-size: 11px; color: var(--ink-soft); text-align: right; font-variant-numeric: tabular-nums; }
.tmid { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 4px 20px 0; text-align: center; }
.ring { position: relative; width: 186px; height: 186px; }
.ring > svg { width: 100%; height: 100%; transform: rotate(-90deg); }
.ring-bg { fill: none; stroke: rgba(44,74,48,.13); stroke-width: 7; }
.ring-fg { fill: none; stroke: var(--clay-500); stroke-width: 7; stroke-linecap: round; transition: stroke-dashoffset .25s linear; }
.ring-fig { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; color: var(--forest-700); }
.ring-fig svg { width: 76px; height: 76px; }
.pname { font-family: var(--f-display); font-weight: 700; font-size: 32px; color: var(--forest-800); margin: 14px 0 0; }
.pcue { font-size: 12px; color: var(--ink-soft); margin: 2px 0 0; }
.ptime { font-weight: 800; font-size: 38px; margin: 6px 0 0; letter-spacing: -.5px; font-variant-numeric: tabular-nums; }
.pnext { font-size: 12px; color: var(--ink-soft); margin-top: 8px; background: rgba(255,255,255,.55); padding: 5px 12px; border-radius: 999px; }
.ctrls { padding: 10px 20px 22px; display: flex; justify-content: center; gap: 22px; }
.ccol { display: flex; flex-direction: column; align-items: center; gap: 4px; font-size: 10px; color: var(--ink-soft); }
.cbtn { border: 0; background: rgba(255,255,255,.6); width: 46px; height: 46px; border-radius: 999px; display: flex; align-items: center; justify-content: center; cursor: pointer; color: var(--forest-800); }
.cbtn svg { width: 18px; height: 18px; }
.cmain { width: 66px; height: 66px; background: var(--forest-700); color: #fff; box-shadow: 0 10px 22px -8px rgba(44,74,48,.55); }
.cmain svg { width: 24px; height: 24px; }

/* complete */
.done { height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 20px 24px; text-align: center; }
.badge { width: 84px; height: 84px; border-radius: 999px; background: var(--clay-100); display: flex; align-items: center; justify-content: center; color: var(--clay-500); margin-bottom: 14px; }
.badge svg { width: 36px; height: 36px; }
.stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin: 18px 0 16px; width: 100%; }
.stat { background: var(--card); border: 1px solid var(--line); border-radius: 14px; padding: 12px 4px; }
.stat b { display: block; font-weight: 800; font-size: 19px; color: var(--forest-800); font-variant-numeric: tabular-nums; }
.stat span { font-size: 10px; color: var(--ink-soft); }

/* progress */
.week { display: grid; grid-template-columns: repeat(7, 1fr); margin: 6px 0 20px; }
.day { display: flex; flex-direction: column; align-items: center; gap: 6px; font-size: 10px; font-weight: 600; color: var(--ink-soft); }
.dot { width: 28px; height: 28px; border-radius: 999px; background: var(--sage-200); display: flex; align-items: center; justify-content: center; color: #fff; }
.day.on .dot { background: var(--forest-700); }
.day.today span { color: var(--forest-800); text-decoration: underline; text-underline-offset: 3px; }
.dot svg { width: 13px; height: 13px; }
.streak { background: var(--forest-800); color: #F3F6EE; border-radius: 18px; padding: 15px 18px; display: flex; align-items: center; gap: 14px; }
.streak b { font-family: var(--f-display); font-size: 38px; line-height: 1; }
.streak span { font-size: 11.5px; opacity: .85; line-height: 1.4; }
.hrow { display: flex; align-items: center; gap: 12px; padding: 10px 0; border-bottom: 1px solid var(--line); }
.hrow:last-child { border-bottom: 0; }
.hicon { width: 34px; height: 34px; border-radius: 10px; background: var(--sage-200); display: flex; align-items: center; justify-content: center; color: var(--forest-700); flex-shrink: 0; }
.hicon svg { width: 20px; height: 20px; }
.hname { font-size: 13px; font-weight: 700; }
.hwhen { font-size: 11px; color: var(--ink-soft); }

/* create */
.field { display: flex; flex-direction: column; gap: 6px; margin-bottom: 14px; }
.field label { font-size: 12px; font-weight: 700; color: var(--ink-soft); }
.field input { border: 1.5px solid var(--line); background: var(--card); border-radius: 12px; padding: 11px 12px; color: var(--ink); }
.chips { display: flex; flex-wrap: wrap; gap: 6px; }
.chip { border: 1px solid var(--line); background: var(--card); border-radius: 999px; padding: 6px 10px 6px 6px; display: inline-flex; align-items: center; gap: 4px; font-size: 11.5px; font-weight: 600; color: var(--forest-800); cursor: pointer; }
.chip svg { width: 18px; height: 18px; color: var(--forest-700); }
.plist { display: flex; flex-direction: column; gap: 8px; margin: 4px 0 14px; }
.prow { display: flex; align-items: center; gap: 8px; background: var(--card); border: 1px solid var(--line); border-radius: 12px; padding: 7px 8px; }
.prow .n { flex: 1; min-width: 0; font-size: 12.5px; font-weight: 700; }
.prow input { width: 52px; border: 1px solid var(--line); border-radius: 8px; padding: 5px 6px; text-align: right; background: var(--sage-100); color: var(--ink); font-variant-numeric: tabular-nums; }
.prow .s { font-size: 11px; color: var(--ink-soft); }
.x { border: 0; background: none; color: var(--ink-soft); cursor: pointer; font-size: 18px; line-height: 1; padding: 2px 4px; }
.formerr { color: var(--clay-500); font-size: 12px; font-weight: 600; min-height: 16px; margin-bottom: 8px; }

/* ---------- workbench ---------- */
.bench { display: flex; flex-direction: column; gap: 18px; min-width: 0; }
.panel { background: var(--panel); border: 1px solid var(--panel-line); border-radius: 14px; padding: 16px; min-width: 0; }
.ph { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 6px 12px; margin-bottom: 10px; }
.ph h2 { margin: 0; font-size: 15px; font-weight: 800; }
.ph p { margin: 0; color: var(--page-soft); font-size: 12.5px; }
.state { font-size: 11.5px; font-weight: 700; letter-spacing: .04em; text-transform: uppercase; }
.state.ok { color: var(--ok); } .state.dirty { color: var(--clay-500); } .state.bad { color: var(--bad); }
textarea#json { width: 100%; min-height: 380px; resize: vertical; background: var(--code-bg); color: var(--page-ink); border: 1px solid var(--panel-line); border-radius: 10px; padding: 12px; font-family: var(--f-mono); font-size: 12px; line-height: 1.55; tab-size: 2; white-space: pre; overflow: auto; }
.actions { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 10px; }
.tb { border: 1px solid var(--panel-line); background: var(--page); color: var(--page-ink); border-radius: 9px; padding: 8px 12px; font-size: 12.5px; font-weight: 700; cursor: pointer; }
.tb.primary { background: var(--forest-700); border-color: var(--forest-700); color: #F3F6EE; }
.tb.file { position: relative; overflow: hidden; }
.tb.file input { position: absolute; inset: 0; opacity: 0; cursor: pointer; }
.msg { margin-top: 10px; font-size: 12.5px; line-height: 1.5; }
.msg.bad { color: var(--bad); } .msg.ok { color: var(--ok); }
.msg ul { margin: 4px 0 0; padding-left: 18px; }
.banner { background: var(--warn-bg); border-radius: 9px; padding: 8px 10px; font-size: 12.5px; margin-bottom: 10px; display: flex; flex-wrap: wrap; align-items: center; gap: 8px; justify-content: space-between; }
.log { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; font-size: 12.5px; }
.log li { display: grid; grid-template-columns: 64px minmax(0, 1fr); gap: 10px; padding: 6px 0; border-bottom: 1px solid var(--panel-line); }
.log li:last-child { border-bottom: 0; }
.log time { font-family: var(--f-mono); font-size: 11px; color: var(--page-soft); font-variant-numeric: tabular-nums; }
.schema { font-family: var(--f-mono); font-size: 11.5px; line-height: 1.6; color: var(--page-soft); margin: 0; overflow-x: auto; white-space: pre; }
.checks { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 6px 18px; margin: 0; padding: 0; list-style: none; font-size: 12.5px; }
.checks label { display: flex; gap: 8px; align-items: flex-start; cursor: pointer; line-height: 1.4; }
.checks input { margin-top: 2px; accent-color: var(--forest-700); }
@media (prefers-reduced-motion: reduce) { * { transition: none !important; } }
</style>

<div class="wrap">
  <header class="top">
    <div>
      <h1 class="brand">strtch<small>test lab</small></h1>
      <p>Use the app on the phone and watch its data change in the JSON panel. Edit the JSON and press Apply to change routines, poses and history in the app.</p>
    </div>
    <div class="speed">Timer speed
      <div class="seg" id="speedSeg">
        <button type="button" data-speed="1" aria-pressed="true">1×</button>
        <button type="button" data-speed="5" aria-pressed="false">5×</button>
        <button type="button" data-speed="20" aria-pressed="false">20×</button>
      </div>
    </div>
  </header>

  <div class="layout">
    <div class="phone">
      <div class="pi">
        <div class="statusbar"></div>
        <div class="screen" id="screen"></div>
        <nav class="tabbar" id="tabbar">
          <button type="button" data-tab="home" class="active"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 11l9-7 9 7"/><path d="M5 10v9a1 1 0 001 1h4v-6h4v6h4a1 1 0 001-1v-9"/></svg>Home</button>
          <button type="button" data-tab="progress"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"/><path d="M7 15l4-5 3 3 5-7"/></svg>Progress</button>
        </nav>
      </div>
    </div>

    <div class="bench">
      <section class="panel">
        <div class="ph"><h2>App data (JSON)</h2><span class="state ok" id="jsonState">In sync</span></div>
        <div class="banner" id="staleBanner" hidden><span>The app changed while you were editing.</span><button type="button" class="tb" id="discardBtn">Discard my edits and show latest</button></div>
        <textarea id="json" spellcheck="false" aria-label="App data as JSON"></textarea>
        <div class="actions">
          <button type="button" class="tb primary" id="applyBtn">Apply to app</button>
          <button type="button" class="tb" id="formatBtn">Tidy</button>
          <button type="button" class="tb" id="copyBtn">Copy JSON</button>
          <span class="tb file">Load .json file<input type="file" id="fileIn" accept=".json,application/json"></span>
          <button type="button" class="tb" id="resetBtn">Reset to sample</button>
        </div>
        <div class="banner" id="resetConfirm" hidden style="margin-top:10px"><span>Replace all routines and history with the sample data?</span><span style="display:flex;gap:6px"><button type="button" class="tb primary" id="resetYes">Reset</button><button type="button" class="tb" id="resetNo">Cancel</button></span></div>
        <div class="msg" id="jsonMsg" role="status"></div>
      </section>

      <section class="panel">
        <div class="ph"><h2>Things to test</h2><p>Tick them off as you go</p></div>
        <ul class="checks" id="checks">
          <li><label><input type="checkbox" id="c1">Start a routine from Home and let it finish</label></li>
          <li><label><input type="checkbox" id="c2">Pause, resume, skip and go back a pose</label></li>
          <li><label><input type="checkbox" id="c3">Create a new routine and run it</label></li>
          <li><label><input type="checkbox" id="c4">Check the new session on Progress</label></li>
          <li><label><input type="checkbox" id="c5">Rename a pose or change its seconds in JSON</label></li>
          <li><label><input type="checkbox" id="c6">Break the JSON on purpose and read the error</label></li>
        </ul>
      </section>

      <section class="panel">
        <div class="ph"><h2>Activity</h2><p>Latest first</p></div>
        <ul class="log" id="log"></ul>
      </section>

      <section class="panel">
        <div class="ph"><h2>Data shape</h2><p>Pose ids pick the drawing; unknown ids get a default one</p></div>
        <pre class="schema">{
  "routines": [{
    "id": "morning",            // unique text
    "name": "Morning Mobility",
    "color": "sage" | "clay",   // card swatch
    "poses": [{ "pose": "catcow", "name": "Cat–Cow",
                "cue": "Move slow with your breath", "secs": 20 }]
  }],
  "history": [{ "routineId": "morning", "name": "Morning Mobility",
                "completedAt": "2026-10-15T08:12:00.000Z",
                "poses": 5, "secs": 125 }]
}
pose ids: catcow, childspose, cobra, pigeon, forwardfold,
          seatedtwist, legsupwall, neckroll, shoulder</pre>
      </section>
    </div>
  </div>
</div>

<script>
(function () {
  "use strict";
  const ST = 'fill="none" stroke="currentColor" stroke-width="4.5" stroke-linecap="round" stroke-linejoin="round"';
  const POSES = {
    catcow: ['Cat–Cow', '<circle cx="22" cy="34" r="7"/><path d="M28 40 C45 20, 65 20, 82 40"/><path d="M28 40 L24 78"/><path d="M34 42 L32 78"/><path d="M78 40 L84 78"/><path d="M72 42 L74 78"/>'],
    childspose: ["Child's Pose", '<circle cx="76" cy="30" r="7"/><path d="M70 34 C50 40, 30 48, 20 62"/><path d="M70 34 C55 55, 40 66, 20 62"/><path d="M20 62 L20 76"/><path d="M35 66 L40 78"/>'],
    cobra: ['Cobra Pose', '<circle cx="72" cy="34" r="7"/><path d="M66 40 C50 46, 38 50, 22 78"/><path d="M50 44 L44 62"/><path d="M58 40 L60 60"/>'],
    pigeon: ['Pigeon Pose', '<circle cx="30" cy="28" r="7"/><path d="M32 34 L40 60"/><path d="M40 60 L78 66"/><path d="M40 60 L30 78"/><path d="M32 40 L58 46 L54 60"/>'],
    forwardfold: ['Forward Fold', '<circle cx="50" cy="22" r="7"/><path d="M50 29 L58 52"/><path d="M58 52 L60 80"/><path d="M58 52 L36 60"/><path d="M36 60 L30 40"/>'],
    seatedtwist: ['Seated Twist', '<circle cx="50" cy="24" r="7"/><path d="M50 31 L52 58"/><path d="M52 58 L30 74"/><path d="M52 58 L74 74"/><path d="M50 40 L74 34"/><path d="M50 44 L28 50"/>'],
