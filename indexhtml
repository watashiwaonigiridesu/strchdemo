  }
  $('applyBtn').onclick = () => applyText(ta.value, 'Applied JSON');
  $('formatBtn').onclick = () => { try { ta.value = JSON.stringify(JSON.parse(ta.value), null, 2); showMsg('', ''); } catch (e) { showMsg('bad', 'Tidy needs valid JSON first: ' + esc(e.message)); } };
  $('discardBtn').onclick = () => { dirty = false; syncJson(false); showMsg('', ''); };
  $('copyBtn').onclick = () => {
    const done = () => showMsg('ok', 'Copied the JSON.');
    const fallback = () => { ta.focus(); ta.select(); showMsg('', 'Text selected. Press Ctrl+C or ⌘C to copy.'); };
    try { navigator.clipboard.writeText(ta.value).then(done, fallback); } catch (e) { fallback(); }
  };
  $('fileIn').onchange = e => {
    const f = e.target.files[0]; if (!f) return;
    const rd = new FileReader();
