  /* ---------- validation ---------- */
  function validate(d) {
    const e = [];
    if (!d || typeof d !== 'object' || Array.isArray(d)) return ['The top level must be an object with "routines" and "history".'];
    if (!Array.isArray(d.routines)) e.push('"routines" must be a list ([ ... ]).');
    else d.routines.forEach((r, i) => {
      const at = `routines[${i}]`;
      if (!r || typeof r !== 'object') { e.push(`${at} must be an object.`); return; }
      if (typeof r.name !== 'string' || !r.name.trim()) e.push(`${at}.name must be non-empty text.`);
      if (!Array.isArray(r.poses) || !r.poses.length) e.push(`${at}.poses must be a list with at least one pose.`);
      else r.poses.forEach((p, j) => {
        if (!p || typeof p !== 'object') { e.push(`${at}.poses[${j}] must be an object.`); return; }
        if (typeof p.name !== 'string' || !p.name.trim()) e.push(`${at}.poses[${j}].name must be non-empty text.`);
        if (!Number.isInteger(p.secs) || p.secs < 1 || p.secs > 600) e.push(`${at}.poses[${j}].secs must be a whole number from 1 to 600.`);
      });
    });
    if (d.history !== undefined && !Array.isArray(d.history)) e.push('"history" must be a list ([ ... ]).');
    else (d.history || []).forEach((h, i) => {
      if (!h || isNaN(new Date(h.completedAt))) e.push(`history[${i}].completedAt must be a date like "2026-10-15T08:12:00Z".`);
    });
    return e;
  }
  function normalise(d) {
    const ids = new Set();
    d.routines.forEach((r, i) => {
      if (typeof r.id !== 'string' || !r.id || ids.has(r.id)) r.id = 'r' + Date.now().toString(36) + i;
      ids.add(r.id);
      if (r.color !== 'clay') r.color = 'sage';
      r.poses.forEach(p => { if (typeof p.cue !== 'string') p.cue = ''; if (typeof p.pose !== 'string') p.pose = 'childspose'; });
    });
    d.history = (d.history || []).slice().sort((a, b) => new Date(b.completedAt) - new Date(a.completedAt));
    return d;
  }

  /* ---------- storage ---------- */
  const KEY = 'strtch-test-lab-v1';
  function load() {
