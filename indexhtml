    rd.readAsText(f); e.target.value = '';
  };
  $('resetBtn').onclick = () => { $('resetConfirm').hidden = false; };
  $('resetNo').onclick = () => { $('resetConfirm').hidden = true; };
  $('resetYes').onclick = () => { $('resetConfirm').hidden = true; dirty = false; applyText(JSON.stringify(sample()), 'Reset to sample'); };

  /* checklist (remembered per browser) */
  const CK = 'strtch-test-lab-checks';
  let checks = {}; try { checks = JSON.parse(localStorage.getItem(CK)) || {}; } catch (e) {}
  document.querySelectorAll('#checks input').forEach(cb => {
    cb.checked = !!checks[cb.id];
    cb.onchange = () => { checks[cb.id] = cb.checked; try { localStorage.setItem(CK, JSON.stringify(checks)); } catch (e) {} };
  });
  function check(id) { const cb = $(id); if (cb && !cb.checked) { cb.checked = true; cb.onchange(); } }

  /* speed */
  $('speedSeg').onclick = e => {
